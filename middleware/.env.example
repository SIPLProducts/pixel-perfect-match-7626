PORT=3002
PROXY_SECRET=change-me-to-a-long-random-value
# Comma-separated SAP hostnames the proxy may reach (recommended)
ALLOWED_SAP_HOSTS=
# Set to 1 only if SAP uses a self-signed certificate
SAP_INSECURE_TLS=0

# How long to wait for SAP (milliseconds)
TIMEOUT_MS=180000
# Characters of request/response payload shown in the terminal (0 = everything)
MAX_LOG_BODY=4000
